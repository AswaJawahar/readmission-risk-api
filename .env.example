# Copy to .env (gitignored) and fill in. Real environment variables override this file.
# none = rule-based mode (default). No real LLM provider is wired up yet.
LLM_PROVIDER=none
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT_SECONDS=8
# true = only use knowledge-base excerpts a reviewer has approved
KB_REQUIRE_VERIFIED=false
