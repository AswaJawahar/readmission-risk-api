# Copy to .env (gitignored) and fill in. Real environment variables override this file.
# none = rule-based mode (default). No real LLM provider is wired up yet.
LLM_PROVIDER=none
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT_SECONDS=8
# true = only use knowledge-base excerpts a reviewer has approved
KB_REQUIRE_VERIFIED=false
# Mock role-based access (leave empty for open access; /audit then stays unavailable).
# JSON mapping each demo key to a role (discharge_staff or auditor) and a mock user id. Use your own random keys.
ROLE_KEYS=
# Example: ROLE_KEYS={"replace-with-a-random-staff-key": {"role": "discharge_staff", "user": "nurse-01"}, "replace-with-a-random-auditor-key": {"role": "auditor", "user": "auditor-01"}}
# Where the metadata-only audit log is written (default: logs/audit.jsonl)
AUDIT_LOG_PATH=
